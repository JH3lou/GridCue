{
  "name": "gridcue-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm --filter gridcue build",
    "dev:vite": "pnpm build && pnpm --filter @gridcue-internal/example-vite dev",
    "dev:next": "pnpm build && pnpm --filter @gridcue-internal/example-next dev",
    "dev:site": "pnpm --filter @gridcue-internal/site dev",
    "build:site": "pnpm --filter @gridcue-internal/site build",
    "lint": "biome check . && oxlint",
    "format": "biome check --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:live": "vitest run --project live --mode live",
    "eval": "tsx evals/cli.ts",
    "eval:live": "tsx --env-file-if-exists=.env.local evals/cli.ts --live",
    "eval:record": "tsx --env-file-if-exists=.env.local evals/record.ts",
    "registry:build": "pnpm --filter @gridcue-internal/registry build",
    "check:package": "pnpm --filter gridcue check:package",
    "check:bundles": "pnpm build && JEV_API_KEY=gridcue-bundle-canary pnpm --filter \"./examples/*\" build && JEV_API_KEY=gridcue-bundle-canary pnpm --filter @gridcue-internal/site build && node scripts/check-bundles.mjs",
    "check": "pnpm lint && pnpm build && pnpm typecheck && pnpm test && pnpm eval && pnpm registry:build && pnpm check:package && pnpm check:skills && pnpm check:bundles",
    "check:skills": "node scripts/check-skills.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@shadcn/lint": "0.2.0",
    "oxlint": "1.85.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
